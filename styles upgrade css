.live-indicator {
  margin-top: 10px;
  font-size: 14px;
  color: #10b981;
}

.dot {
  height: 10px;
  width: 10px;
  background: #10b981;
  border-radius: 50%;
  display: inline-block;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

.card {
  background: linear-gradient(145deg, #1f2937, #111827);
  border: 1px solid rgba(255,255,255,0.05);
  transition: 0.3s;
}

.card:hover {
  transform: scale(1.03);
  box-shadow: 0 0 20px rgba(37,99,235,0.4);
}